{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Updater",
  "version": "0.1.8",
  "identifier": "com.qsltd.updater",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:14202",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "正在启动",
        "url": "splash.html",
        "width": 280,
        "height": 160,
        "resizable": false,
        "center": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "hiddenTitle": true,
        "visible": true
      },
      {
        "label": "main",
        "title": "更新程序",
        "width": 440,
        "height": 300,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": false,
        "maximizable": false,
        "hiddenTitle": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
